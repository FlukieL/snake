{
  "name": "snake-game",
  "version": "2.0.0",
  "description": "Modern Snake game deployed on Cloudflare Workers with a D1-backed global leaderboard",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:development": "wrangler dev --env development",
    "deploy": "wrangler deploy",
    "deploy:development": "wrangler deploy --env development",
    "db:create": "wrangler d1 create snake-scores",
    "db:migrate:local": "wrangler d1 execute snake-scores --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute snake-scores --remote --file=./schema.sql",
    "db:migrate:dev:local": "wrangler d1 execute snake-scores --local --file=./schema.dev.sql",
    "db:migrate:dev:remote": "wrangler d1 execute snake-scores --remote --file=./schema.dev.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
